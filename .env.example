# Server
PORT=4000

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/portfolio

# Comma-separated list of origins allowed to call the API (portfolio site + admin UI)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8080

# Secret key the admin UI must send to add, edit or delete data.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=change-me

# ---- Email alerts for new contact messages (optional) ----
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it as SMTP_PASS (no spaces).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Where alerts are sent (defaults to SMTP_USER)
NOTIFY_EMAIL=

# Set to 1 when deployed behind a proxy (Render, Railway, nginx…)
TRUST_PROXY=0
